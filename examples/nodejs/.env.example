# Bring your own LLM key. Shipi18n has no account and no API of its own —
# these keys belong to you and are used to call your provider directly.

# Anthropic (default provider)
ANTHROPIC_API_KEY=your-key-here

# Or use OpenAI instead, with SHIPI18N_PROVIDER=openai
# OPENAI_API_KEY=your-key-here
# SHIPI18N_PROVIDER=openai
