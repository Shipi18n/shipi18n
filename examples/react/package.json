{
  "name": "shipi18n-react-example",
  "version": "1.0.0",
  "description": "React + react-i18next example: locale files translated at build time with your own LLM key",
  "type": "module",
  "scripts": {
    "i18n": "shipi18n translate src/locales/en.json -t es,fr,de -o src/locales --incremental",
    "dev": "vite",
    "build": "npm run i18n && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "i18next": "^23.11.5",
    "react-i18next": "^14.1.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@shipi18n/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "vite": "^5.4.11"
  },
  "keywords": [
    "i18n",
    "translation",
    "react",
    "react-i18next",
    "example",
    "shipi18n",
    "llm",
    "bring-your-own-key"
  ],
  "author": "Shipi18n",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shipi18n/shipi18n-react-example"
  }
}
