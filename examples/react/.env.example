# Bring your own LLM key. It is used by `npm run i18n` at BUILD time only and is
# never bundled into the app — a key in a browser is a leaked key.
#
# Shipi18n has no account and no API of its own.

ANTHROPIC_API_KEY=your-key-here

# Or, to use OpenAI, add `-p openai` to the i18n script and set:
# OPENAI_API_KEY=your-key-here
