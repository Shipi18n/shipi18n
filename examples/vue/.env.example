# Bring your own LLM key. It is read by vite-plugin-shipi18n during the BUILD
# and never reaches the browser.
#
# Do NOT prefix it with VITE_: Vite inlines those into the client bundle, which
# would publish your key to every visitor.

ANTHROPIC_API_KEY=your-key-here

# Or set provider: 'openai' in vite.config.js and use:
# OPENAI_API_KEY=your-key-here
