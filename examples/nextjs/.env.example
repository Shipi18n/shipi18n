# Bring your own LLM key. It is used by `npm run i18n` at BUILD time only —
# never at request time, and never in the browser.
#
# Do NOT prefix it with NEXT_PUBLIC_: Next.js inlines those into the client
# bundle, which would publish your key to every visitor.

ANTHROPIC_API_KEY=your-key-here

# Or, with `-p openai` added to the i18n script:
# OPENAI_API_KEY=your-key-here
