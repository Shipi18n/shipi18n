{
  "name": "shipi18n-nextjs-example",
  "version": "1.0.0",
  "description": "Next.js App Router example: messages translated at build time with your own LLM key",
  "private": true,
  "scripts": {
    "i18n": "shipi18n translate messages/en.json -t es,fr,de -o messages --incremental",
    "dev": "next dev",
    "build": "npm run i18n && next build",
    "build:only": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@shipi18n/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0"
  },
  "license": "Apache-2.0",
  "keywords": [
    "i18n",
    "translation",
    "nextjs",
    "app-router",
    "example",
    "shipi18n",
    "llm",
    "bring-your-own-key"
  ]
}
