{
  "name": "@shipi18n/cli",
  "version": "2.16.1",
  "description": "Catch broken translations before you ship: dropped placeholders, missing keys, collapsed plurals and — with your own LLM key — mistranslations the structure checks cannot see. CI-ready (SARIF, JUnit, exit codes). Translates too.",
  "type": "module",
  "bin": {
    "shipi18n": "./bin/shipi18n.js"
  },
  "files": [
    "bin",
    "src",
    "!src/__tests__",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --passWithNoTests"
  },
  "keywords": [
    "i18n",
    "l10n",
    "localization",
    "translation",
    "translation-quality",
    "i18n-qa",
    "linter",
    "lint",
    "check",
    "ci",
    "sarif",
    "icu",
    "i18next",
    "placeholder",
    "interpolation",
    "missing-keys",
    "plural",
    "gettext",
    "xliff",
    "android-strings",
    "xcstrings",
    "arb",
    "ai-translation"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "author": "Shipi18n",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shipi18n/shipi18n.git",
    "directory": "packages/cli"
  },
  "dependencies": {
    "@shipi18n/core": "workspace:^",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ora": "^8.0.1"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "esbuild": "0.28.2",
    "fast-xml-parser": "^5.10.1",
    "jest": "^29.7.0"
  }
}
