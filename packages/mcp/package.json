{
  "name": "@shipi18n/mcp",
  "version": "2.1.0",
  "description": "MCP server for i18n quality assurance — check, diff and review locale files from any MCP client. Validation needs no API key.",
  "type": "module",
  "bin": {
    "shipi18n-mcp": "./src/server.js"
  },
  "main": "src/server.js",
  "files": [
    "src",
    "!src/__tests__",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --passWithNoTests",
    "start": "node src/server.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "i18n",
    "translation",
    "validation",
    "linting",
    "localization",
    "llm",
    "bring-your-own-key",
    "i18n-qa",
    "translation-quality",
    "agent"
  ],
  "license": "Apache-2.0",
  "author": "Shipi18n",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shipi18n/shipi18n.git",
    "directory": "packages/mcp"
  },
  "dependencies": {
    "@shipi18n/core": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
