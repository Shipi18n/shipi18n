# Dockerfile for the Shipi18n CHECK CLI — a Node-free way to run the linter.
#
# The GitHub Action already bundles Node for you. This image is for everywhere
# else: GitLab CI, Bitbucket Pipelines, Jenkins, CircleCI, pre-commit, and local
# runs — the PHP / Python / Ruby shops the .po / XLIFF / Android formats unlocked,
# who don't want a Node toolchain just to lint their catalogs.
#
#   docker build -t shipi18n-cli -f Dockerfile.cli .
#   docker run --rm -v "$PWD:/work" shipi18n-cli check ./locales -s en
#
# The published image (built by .github/workflows/docker.yml on each v* tag):
#   docker run --rm -v "$PWD:/work" ghcr.io/shipi18n/cli:latest check ./locales
#
# The check/validator path needs NO API key. The optional --semantic pass does;
# pass it through only if you use it:
#   -e ANTHROPIC_API_KEY=...   or   -e OPENAI_API_KEY=...
#
# Installs the published package (not a monorepo build): it's exactly what users
# run via `npx @shipi18n/cli`, and keeps the image tiny. Base pinned by digest so
# the build is reproducible and can't silently pull a re-tagged image; bump the
# tag and digest together when refreshing (shared with the MCP Dockerfile).
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32

# Which CLI to bake in. Overridable at build time (--build-arg CLI_VERSION=x.y.z);
# the docker.yml workflow passes the tag being released. Bump the default with
# each release so a plain `docker build` gets the current linter.
ARG CLI_VERSION=2.11.0

RUN npm install -g "@shipi18n/cli@${CLI_VERSION}" \
  && npm cache clean --force

# Users mount their repo here; check paths are then relative to the repo root.
WORKDIR /work

# ENTRYPOINT is the binary so `docker run <img> check ./locales` appends cleanly.
# Default command runs a check of the conventional ./locales dir with no args.
ENTRYPOINT ["shipi18n"]
CMD ["check", "./locales"]
